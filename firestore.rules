rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function authenticated(){return request.auth != null;}
  function signed(){return authenticated();}
  function platformAdmin(){return signed() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));}
  function unitAccess(org) {
   let path = /databases/$(database)/documents/platformSubscriptions/$(org);
   return exists(path) ? (get(path).data.status in ['active','trial'] && 'expiresAt' in get(path).data && request.time < get(path).data.expiresAt) : (request.time < get(/databases/$(database)/documents/establishments/$(org)).data.createdAt + duration.value(7,'d'));
  }
  match /customerAccounts/{uid} { allow get: if signed() && request.auth.uid == uid; allow create: if authenticated() && !exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) && request.auth.uid == uid && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role == 'customer'; }
  match /customerAccounts/{uid}/pushDevices/{device} {
   allow get, list, delete: if signed() && request.auth.uid == uid;
   allow create, update: if signed() && request.auth.uid == uid && exists(/databases/$(database)/documents/customerAccounts/$(uid)) && device.matches('[a-f0-9]{64}') && request.resource.data.keys().hasOnly(['token','org','updatedAt']) && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 4096 && request.resource.data.org is string && unitAccess(request.resource.data.org) && request.resource.data.updatedAt == request.time;
  }
  match /managerAccounts/{uid} { allow get: if signed() && (request.auth.uid == uid || platformAdmin()); allow create: if platformAdmin() || (authenticated() && !exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) && request.auth.uid == uid && request.resource.data.keys().hasOnly(['role','selfRegistered']) && request.resource.data.role == 'manager' && request.resource.data.selfRegistered == true); allow update, delete: if platformAdmin(); }
  match /platformAdmins/{uid} { allow get: if signed() && request.auth.uid == uid; }
  match /platformSubscriptions/{org} {
   allow read: if platformAdmin();
   allow get: if signed() && get(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == request.auth.uid;
   allow create, update: if platformAdmin() && existsAfter(/databases/$(database)/documents/establishments/$(org)) && request.resource.data.keys().hasOnly(['status','until','monthlyCents','updatedAt','expiresAt']) && request.resource.data.status in ['trial','active','blocked','inactive'] && request.resource.data.until is string && request.resource.data.until.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.monthlyCents is int && request.resource.data.monthlyCents >= 0 && request.resource.data.monthlyCents <= 10000000 && request.resource.data.expiresAt is timestamp && request.resource.data.updatedAt == request.time;
  }
  match /commercialSettings/{id} {
   allow read: if id == 'public';
   allow write: if platformAdmin() && id == 'public' && request.resource.data.keys().hasOnly(['pix','whatsapp','monthly','annual']) && request.resource.data.pix is string && request.resource.data.pix.size() <= 200 && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('[0-9]{10,15}') && request.resource.data.monthly is int && request.resource.data.monthly > 0 && request.resource.data.annual is int && request.resource.data.annual > 0;
  }
  match /licensePayments/{id} {
   allow read: if platformAdmin();
   allow create: if platformAdmin() && request.resource.data.keys().hasOnly(['org','plan','amount','reference','createdAt','adminUid']) && request.resource.data.org is string && request.resource.data.plan in ['monthly','annual','courtesy'] && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.reference is string && request.resource.data.reference.size() <= 250 && request.resource.data.createdAt == request.time && request.resource.data.adminUid == request.auth.uid;
  }
  match /publicCatalogs/{org} {
   allow read: if unitAccess(org);
   allow create, update: if unitAccess(org) && signed() && get(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == request.auth.uid;
  }
  match /staffAccess/{uid}/profiles/{key} {
   allow read: if signed() && request.auth.uid == uid;
   allow create, update: if signed() && unitAccess(request.resource.data.org) && request.resource.data.keys().hasOnly(['org','professional']) && key == request.resource.data.org + '_' + request.resource.data.professional && get(/databases/$(database)/documents/establishments/$(request.resource.data.org)).data.ownerUid == request.auth.uid && getAfter(/databases/$(database)/documents/establishments/$(request.resource.data.org)/professionals/$(request.resource.data.professional)).data.uid == uid;
   allow delete: if signed() && get(/databases/$(database)/documents/establishments/$(resource.data.org)).data.ownerUid == request.auth.uid;
  }
  match /establishments/{org} {
   allow read: if platformAdmin() || (signed() && resource.data.ownerUid == request.auth.uid);
   allow create: if ((signed() && !platformAdmin() && org == request.auth.uid && request.resource.data.ownerUid == request.auth.uid && exists(/databases/$(database)/documents/managerAccounts/$(request.auth.uid))) || (platformAdmin() && existsAfter(/databases/$(database)/documents/platformSubscriptions/$(org)) && getAfter(/databases/$(database)/documents/platformSubscriptions/$(org)).data.status == 'inactive')) && request.resource.data.keys().hasOnly(['name','segment','ownerUid','createdAt']) && request.resource.data.ownerUid is string && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.segment is string && request.resource.data.segment.size() <= 100 && request.resource.data.createdAt == request.time;
   function owner(){return unitAccess(org) && signed() && get(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == request.auth.uid;}
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','segment','brand']) && (!('brand' in request.resource.data) || validBrand(request.resource.data.brand)) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.segment is string;
   function validBrand(b){return b is map && b.keys().hasOnly(['logo','address','phone','review']) && b.logo is string && b.logo.size() <= 500 && (b.logo == '' || b.logo.matches('https://.*')) && b.review is string && b.review.size() <= 500 && (b.review == '' || b.review.matches('https://.*')) && b.address is string && b.address.size() <= 250 && b.phone is string && b.phone.size() <= 20;}
   function categoryExists(id){return exists(/databases/$(database)/documents/establishments/$(org)/categories/$(id));}
   function serviceValid(d){return d.keys().hasOnly(['name','priceCents','duration','active','createdAt','categoryId']) && (!('categoryId' in d) || (d.categoryId is string && (d.categoryId == '' || categoryExists(d.categoryId)))) && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 10000000 && d.duration is int && d.duration >= 5 && d.duration <= 720 && d.duration % 5 == 0 && d.active is bool && d.createdAt is timestamp;}
   function proValid(d){return d.keys().hasOnly(['name','specialty','email','photo','active','serviceIds','createdAt','uid','archived']) && (!('archived' in d) || (d.archived is bool && (!d.archived || (d.active == false && d.uid == '')))) && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.specialty is string && d.specialty.size() > 0 && d.specialty.size() <= 100 && d.email is string && d.email.size() <= 254 && d.photo is string && d.photo.size() <= 120000 && (d.photo == '' || d.photo.matches('https://.*') || d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')) && (!('uid' in d) || (d.uid is string && d.uid.size() <= 128)) && d.active is bool && d.serviceIds is list && d.serviceIds.size() <= 200 && d.createdAt is timestamp;}
   match /loyaltySettings/{id} {
    allow read: if owner();
    allow create, update: if owner() && id == 'campaign' && request.resource.data.keys().hasOnly(['name','goal','active']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.goal is int && request.resource.data.goal >= 1 && request.resource.data.goal <= 100 && request.resource.data.active is bool;
   }
   match /rewardBalances/{uid} { allow delete: if owner();
    allow read: if owner() || (unitAccess(org) && signed() && request.auth.uid == uid);
    allow create, update: if owner() && request.resource.data.keys().hasOnly(['used','lastReward','updatedAt']) && request.resource.data.used is int && request.resource.data.used > 0 && request.resource.data.lastReward is string && request.resource.data.lastReward.size() <= 100 && request.resource.data.updatedAt == request.time && (!exists(/databases/$(database)/documents/establishments/$(org)/rewardBalances/$(uid)) || request.resource.data.used > resource.data.used);
   }
   match /customers/{id} {
    allow read: if owner();
    allow create, update: if owner() && request.resource.data.keys().hasOnly(['name','email','phone']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
   }
   match /categories/{id} {
    allow read: if owner();
    allow create, update: if owner() && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
   }
   match /auditEvents/{event} {
    allow read: if owner();
    allow create: if signed() && unitAccess(org) && request.resource.data.keys().hasOnly(['bookingId','from','to','actor','createdAt']) && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time && validAudit(request.resource.data);
    function validAudit(d) {
     let auditBookingId = d.bookingId;
     let path = /databases/$(database)/documents/establishments/$(org)/bookingRequests/$(auditBookingId);
     let before = get(path).data;
     let after = getAfter(path).data;
     return (owner() || assignedProfessional(before.professional)) && before.status == d.from && after.status == d.to && d.from != d.to;
    }
   }
   match /bookingLocks/{id} {
    function clearAt(oldSlots, slot, i) {
     return oldSlots.size() <= i || slot.end <= oldSlots[i].start || slot.start >= oldSlots[i].end;
    }
    function noOverlap(oldSlots, slot) {
     return oldSlots.size() < 48 && clearAt(oldSlots, slot, 0) && clearAt(oldSlots, slot, 1) && clearAt(oldSlots, slot, 2) && clearAt(oldSlots, slot, 3) && clearAt(oldSlots, slot, 4) && clearAt(oldSlots, slot, 5) && clearAt(oldSlots, slot, 6) && clearAt(oldSlots, slot, 7) && clearAt(oldSlots, slot, 8) && clearAt(oldSlots, slot, 9) && clearAt(oldSlots, slot, 10) && clearAt(oldSlots, slot, 11) && clearAt(oldSlots, slot, 12) && clearAt(oldSlots, slot, 13) && clearAt(oldSlots, slot, 14) && clearAt(oldSlots, slot, 15) && clearAt(oldSlots, slot, 16) && clearAt(oldSlots, slot, 17) && clearAt(oldSlots, slot, 18) && clearAt(oldSlots, slot, 19) && clearAt(oldSlots, slot, 20) && clearAt(oldSlots, slot, 21) && clearAt(oldSlots, slot, 22) && clearAt(oldSlots, slot, 23) && clearAt(oldSlots, slot, 24) && clearAt(oldSlots, slot, 25) && clearAt(oldSlots, slot, 26) && clearAt(oldSlots, slot, 27) && clearAt(oldSlots, slot, 28) && clearAt(oldSlots, slot, 29) && clearAt(oldSlots, slot, 30) && clearAt(oldSlots, slot, 31) && clearAt(oldSlots, slot, 32) && clearAt(oldSlots, slot, 33) && clearAt(oldSlots, slot, 34) && clearAt(oldSlots, slot, 35) && clearAt(oldSlots, slot, 36) && clearAt(oldSlots, slot, 37) && clearAt(oldSlots, slot, 38) && clearAt(oldSlots, slot, 39) && clearAt(oldSlots, slot, 40) && clearAt(oldSlots, slot, 41) && clearAt(oldSlots, slot, 42) && clearAt(oldSlots, slot, 43) && clearAt(oldSlots, slot, 44) && clearAt(oldSlots, slot, 45) && clearAt(oldSlots, slot, 46) && clearAt(oldSlots, slot, 47);
    }
    function customerAppend(oldSlots) {
     let d = request.resource.data;
     let slot = d.slots[d.slots.size()-1];
     let slotBookingId = slot.id;
     let path = /databases/$(database)/documents/establishments/$(org)/bookingRequests/$(slotBookingId);
     let booking = getAfter(path).data;
     let serviceId = booking['service'];
     let serviceDoc = get(/databases/$(database)/documents/establishments/$(org)/services/$(serviceId));
     return signed() && unitAccess(org) && d.keys().hasOnly(['professional','date','slots']) && d.slots is list && d.slots.size() == oldSlots.size()+1 && d.slots == oldSlots.concat([slot]) && slot.keys().hasOnly(['id','start','end']) && slot.start is int && slot.end is int && slot.start >= 0 && slot.end <= 1440 && slot.end > slot.start && noOverlap(oldSlots, slot) && slot.start == int(booking.time.split(':')[0])*60 + int(booking.time.split(':')[1]) && slot.end == slot.start + serviceDoc.data.duration && !exists(path) && booking.uid == request.auth.uid && booking.status == 'pending' && booking.professional == d.professional && booking.date == d.date && id == d.professional+'_'+d.date;
    }
    function customerRelease() {
     let d = request.resource.data;
     let releasedBookingId = d.releasedBooking;
     let path = /databases/$(database)/documents/establishments/$(org)/bookingRequests/$(releasedBookingId);
     let old = get(path).data;
     let after = getAfter(path).data;
     let slot = resource.data.slots[d.releasedIndex];
     return signed() && unitAccess(org) && d.keys().hasOnly(['professional','date','slots','releasedBooking','releasedIndex']) && d.releasedIndex is int && d.releasedIndex >= 0 && d.releasedIndex < resource.data.slots.size() && old.uid == request.auth.uid && old.status == 'confirmed' && after.status == 'cancelled' && old.professional == d.professional && old.date == d.date && d.professional == resource.data.professional && d.date == resource.data.date && id == d.professional+'_'+d.date && slot.id == d.releasedBooking && d.slots == resource.data.slots.removeAll([slot]);
    }
    allow create: if customerAppend([]);
    allow update: if ('releasedBooking' in request.resource.data && 'releasedIndex' in request.resource.data) ? customerRelease() : (request.resource.data.professional == resource.data.professional && request.resource.data.date == resource.data.date && customerAppend(resource.data.slots));
 allow delete: if owner(); allow get: if (unitAccess(org) && exists(/databases/$(database)/documents/publicCatalogs/$(org))) || owner(); allow list: if owner(); allow create, update: if owner() || (assignedProfessional(request.resource.data.professional) && id == request.resource.data.professional + '_' + request.resource.data.date && request.resource.data.keys().hasOnly(['professional','date','slots','releasedBooking','releasedIndex']) && request.resource.data.slots is list); }
   match /services/{id}{
    allow read: if owner();
    allow create: if owner() && serviceValid(request.resource.data) && request.resource.data.createdAt == request.time;
    allow update: if owner() && serviceValid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   }
   match /professionals/{id}{
    allow read: if owner() || (unitAccess(org) && signed() && resource.data.active == true && resource.data.uid == request.auth.uid);
    allow create: if owner() && proValid(request.resource.data) && request.resource.data.createdAt == request.time;
    allow update: if owner() && proValid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   }
   match /availability/{id} {
    function assigned(){return unitAccess(org) && signed() && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.uid == request.auth.uid && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.active == true;}
    allow get: if (unitAccess(org) && exists(/databases/$(database)/documents/publicCatalogs/$(org))) || owner() || assigned();
    allow list: if owner();
    allow create, update: if (owner() || assigned()) && request.resource.data.keys().hasOnly(['week','daysOff']) && request.resource.data.week is list && request.resource.data.week.size() == 7 && request.resource.data.daysOff is list && request.resource.data.daysOff.size() <= 366;
   }
   function assignedProfessional(id){return unitAccess(org) && signed() && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.uid == request.auth.uid && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.active == true;}
   match /notificationPreferences/{id} {
    allow read: if owner() || assignedProfessional(id);
    allow create, update: if (owner() || assignedProfessional(id)) && request.resource.data.keys().hasOnly(['phone','test','newRequests','tomorrow','tomorrowTime','today','todayTime','end','endTime','individual','minutes']) && request.resource.data.phone is string && request.resource.data.phone.matches('55[0-9]{10,11}') && request.resource.data.test is bool && request.resource.data.newRequests is bool && request.resource.data.tomorrow is bool && request.resource.data.today is bool && request.resource.data.end is bool && request.resource.data.individual is bool && request.resource.data.tomorrowTime.matches('[0-2][0-9]:[0-5][0-9]') && request.resource.data.todayTime.matches('[0-2][0-9]:[0-5][0-9]') && request.resource.data.endTime.matches('[0-2][0-9]:[0-5][0-9]') && request.resource.data.minutes is int && request.resource.data.minutes >= 5 && request.resource.data.minutes <= 1440;
   }
   match /policies/{id} {
    allow read: if owner();
    allow create, update: if owner() && id == 'cancellation' && request.resource.data.keys().hasOnly(['text']) && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
   }
   match /commissionRates/{professional} {
    allow read: if owner() || assignedProfessional(professional);
    allow create, update: if owner() && exists(/databases/$(database)/documents/establishments/$(org)/professionals/$(professional)) && request.resource.data.keys().hasOnly(['basisPoints','updatedAt']) && request.resource.data.basisPoints is int && request.resource.data.basisPoints >= 0 && request.resource.data.basisPoints <= 10000 && request.resource.data.updatedAt == request.time;
   }
   match /commissionEntries/{bookingId} {
    function validEntry() {
     let path = /databases/$(database)/documents/establishments/$(org)/bookingRequests/$(bookingId);
     let b = get(path).data;
     let d = request.resource.data;
     let pro = b.professional;
     let ratePath = /databases/$(database)/documents/establishments/$(org)/commissionRates/$(pro);
     let rate = exists(ratePath) ? get(ratePath).data.basisPoints : 0;
     let gross = 'priceCents' in b ? b.priceCents : 0;
     return (owner() || assignedProfessional(pro)) && b.status == 'confirmed' && getAfter(path).data.status == 'completed' && d.keys().hasOnly(['professional','basisPoints','amount','createdAt']) && d.professional == pro && d.basisPoints == rate && d.amount is int && d.amount >= 0 && d.amount * 10000 <= gross * rate && (d.amount + 1) * 10000 > gross * rate && d.createdAt == request.time;
    }
    allow read: if owner() || assignedProfessional(resource.data.professional);
    allow create: if validEntry();
   }
   match /commissionPayments/{bookingId} {
    function validPayment() {
     let b = get(/databases/$(database)/documents/establishments/$(org)/bookingRequests/$(bookingId)).data;
     let d = request.resource.data;
     let entry = get(/databases/$(database)/documents/establishments/$(org)/commissionEntries/$(bookingId)).data;
     return b.status == 'completed' && d.keys().hasOnly(['amount','professional','paidAt','actor']) && d.amount == entry.amount && d.amount > 0 && d.professional == b.professional && d.paidAt == request.time && d.actor == request.auth.uid;
    }
    allow read: if owner() || assignedProfessional(resource.data.professional);
    allow create: if owner() && validPayment();
   }
   match /bookingRequests/{id} { allow delete: if owner() && resource.data.status in ['pending','confirmed'] && !exists(/databases/$(database)/documents/establishments/$(org)/commissionEntries/$(id));
    function validBookingPrice(serviceId, price) {
     let serviceDoc = get(/databases/$(database)/documents/establishments/$(org)/services/$(serviceId));
     return price == serviceDoc.data.priceCents && serviceDoc.data.active == true;
    }
    function validCancellation() {
     let d = request.resource.data;
     return d.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','cancelledBy','cancelledAt']) && d.status == 'cancelled' && d.cancelReason is string && d.cancelReason.size() <= 500 && d.cancelReason.matches('.*[^\\s].*') && d.cancelledBy == request.auth.uid && d.cancelledAt == request.time;
    }
    function validCompletion() {
     let entry = /databases/$(database)/documents/establishments/$(org)/commissionEntries/$(id);
     return resource.data.status == 'confirmed' && request.resource.data.status == 'completed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && !exists(entry) && existsAfter(entry);
    }
    allow update: if (owner() || assignedProfessional(resource.data.professional)) && validCompletion();
    allow update: if (owner() || assignedProfessional(resource.data.professional)) && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && ((resource.data.status == 'pending' && request.resource.data.status == 'confirmed') || (resource.data.status == 'confirmed' && request.resource.data.status == 'no_show'))) || (resource.data.status in ['pending','confirmed'] && validCancellation()));
    allow update: if signed() && unitAccess(org) && resource.data.uid == request.auth.uid && resource.data.status == 'confirmed' && validCancellation();
    allow read: if owner() || (unitAccess(org) && signed() && (resource.data.uid == request.auth.uid || assignedProfessional(resource.data.professional)));
    function validProfessional(proId, serviceId) {
     let pro = get(/databases/$(database)/documents/establishments/$(org)/professionals/$(proId));
     return pro.data.active == true && serviceId in pro.data.serviceIds;
    }
    function validBooking(d) {
     return d.keys().hasOnly(['uid','email','name','phone','professional','service','date','time','status','createdAt','priceCents'])
      && d['service'] is string
      && d.professional is string
      && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
      && d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
      && validProfessional(d.professional, d['service'])
      && d.priceCents is int
      && validBookingPrice(d['service'], d.priceCents)
      && d.uid == request.auth.uid
      && d.email == request.auth.token.email
      && d.status == 'pending'
      && d.createdAt == request.time
      && d.name is string && d.name.size() > 0 && d.name.size() <= 100
      && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
      && exists(/databases/$(database)/documents/publicCatalogs/$(org));
    }
    function hasReservation(d) {
     let lockId = d.professional + '_' + d.date;
     let lock = getAfter(/databases/$(database)/documents/establishments/$(org)/bookingLocks/$(lockId)).data;
     return lock.slots.size() > 0 && lock.slots[lock.slots.size()-1].id == id;
    }
    allow create: if unitAccess(org) && signed() && validBooking(request.resource.data) && hasReservation(request.resource.data);
   }
   match /feedback/{id} { allow delete: if owner();
    function bookingData(){return get(/databases/$(database)/documents/establishments/$(org)/bookingRequests/$(id)).data;}
    allow get: if owner() || (unitAccess(org) && signed() && (bookingData().uid == request.auth.uid || assignedProfessional(bookingData().professional)));
    allow list: if owner();
    allow create: if unitAccess(org) && signed() && bookingData().uid == request.auth.uid && bookingData().status == 'completed' && request.resource.data.keys().hasOnly(['uid','score','comment','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5 && request.resource.data.comment is string && request.resource.data.comment.size() <= 500 && request.resource.data.createdAt == request.time;
   }
   match /members/{uid} {
    allow read: if signed() && request.auth.uid == uid;
    allow create: if signed() && request.auth.uid == uid && getAfter(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == uid && request.resource.data.keys().hasOnly(['uid','role']) && request.resource.data.uid == uid && request.resource.data.role == 'owner';
   }
  }
 }
}
