rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  match /staffAccess/{uid}/profiles/{key} {
   allow read: if signed() && request.auth.uid == uid;
   allow create, update: if signed() && request.resource.data.keys().hasOnly(['org','professional']) && key == request.resource.data.org + '_' + request.resource.data.professional && get(/databases/$(database)/documents/establishments/$(request.resource.data.org)).data.ownerUid == request.auth.uid && getAfter(/databases/$(database)/documents/establishments/$(request.resource.data.org)/professionals/$(request.resource.data.professional)).data.uid == uid;
   allow delete: if signed() && get(/databases/$(database)/documents/establishments/$(resource.data.org)).data.ownerUid == request.auth.uid;
  }
  match /establishments/{org} {
   allow read: if signed() && resource.data.ownerUid == request.auth.uid;
   allow create: if signed() && request.resource.data.keys().hasOnly(['name','segment','ownerUid','createdAt']) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.segment is string && request.resource.data.createdAt == request.time;
   function owner(){return signed() && get(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == request.auth.uid;}
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','segment']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 && request.resource.data.segment is string;
   function serviceValid(d){return d.keys().hasOnly(['name','priceCents','duration','active','createdAt']) && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 10000000 && d.duration is int && d.duration >= 5 && d.duration <= 720 && d.duration % 5 == 0 && d.active is bool && d.createdAt is timestamp;}
   function proValid(d){return d.keys().hasOnly(['name','specialty','email','photo','active','serviceIds','createdAt','uid']) && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.specialty is string && d.specialty.size() > 0 && d.specialty.size() <= 100 && d.email is string && d.email.size() <= 254 && d.photo is string && d.photo.size() <= 120000 && (d.photo == '' || d.photo.matches('https://.*') || d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')) && (!('uid' in d) || (d.uid is string && d.uid.size() <= 128)) && d.active is bool && d.serviceIds is list && d.serviceIds.size() <= 200 && d.createdAt is timestamp;}
   match /services/{id}{
    allow read: if owner();
    allow create: if owner() && serviceValid(request.resource.data) && request.resource.data.createdAt == request.time;
    allow update: if owner() && serviceValid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   }
   match /professionals/{id}{
    allow read: if owner() || (signed() && resource.data.active == true && resource.data.uid == request.auth.uid);
    allow create: if owner() && proValid(request.resource.data) && request.resource.data.createdAt == request.time;
    allow update: if owner() && proValid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   }
   match /availability/{id} {
    function assigned(){return signed() && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.uid == request.auth.uid && get(/databases/$(database)/documents/establishments/$(org)/professionals/$(id)).data.active == true;}
    allow read: if owner() || assigned();
    allow create, update: if (owner() || assigned()) && request.resource.data.keys().hasOnly(['week','daysOff']) && request.resource.data.week is list && request.resource.data.week.size() == 7 && request.resource.data.daysOff is list && request.resource.data.daysOff.size() <= 366;
   }
   match /members/{uid} {
    allow read: if signed() && request.auth.uid == uid;
    allow create: if signed() && request.auth.uid == uid && getAfter(/databases/$(database)/documents/establishments/$(org)).data.ownerUid == uid && request.resource.data.keys().hasOnly(['uid','role']) && request.resource.data.uid == uid && request.resource.data.role == 'owner';
   }
  }
 }
}
